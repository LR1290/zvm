# ZVM Server R46.16 — template sanitizado e fail-closed
# LOCAL: copie como zvm.env e preencha. O launcher aplica o overlay seguro.
# RENDER: use Environment Variables; não envie zvm.env para o repositório.

# Runtime
NODE_ENV=production
PORT=3000
BASE_URL=https://zvm.onrender.com
ZVM_RUNTIME_ENV=production
# RENDER é fornecido pelo próprio Render. Não fixe true em zvm.env local.

# Administração / sessões / criptografia
ADMIN_USER=
ADMIN_PASS=
APP_SECRET=
TOTP_SECRET=
ANALYTICS_PASS=
ANALYTICS_TOTP_SECRET=
PORTAL_TOTP_ENCRYPTION_KEY=
PORTAL_TOTP_ENCRYPTION_KEY_PREVIOUS=
PORTAL_TOTP_MIGRATE_LEGACY=0

# Banco
MONGODB_URI=
MONGODB_DB=zapvoice

# E-mail
RESEND_API_KEY=
EMAIL_FROM=ZVM <noreply@SEU_DOMINIO>
EMAIL_REPLY_TO=suporte@SEU_DOMINIO

# Cakto / comercial / webhooks
CAKTO_WEBHOOK_SECRET=
CAKTO_RECOVERY_SECRET=
CAKTO_RECOVERY_SECRET_PREVIOUS=
CAKTO_ALLOW_DRY_RUN=0
WEBHOOK_URL=
CAKTO_SOLO_OFFER_ID=
CAKTO_SOLO_PRODUCT_ID=
CAKTO_PADRAO_OFFER_ID=
CAKTO_PADRAO_PRODUCT_ID=
CAKTO_PRO_OFFER_ID=
CAKTO_PRO_PRODUCT_ID=
CAKTO_EMPRESARIAL_OFFER_ID=
CAKTO_EMPRESARIAL_PRODUCT_ID=

# Extensão / licenciamento
EXTENSION_URL=
EXTENSION_VERSION=
EXTENSION_CHANGELOG=
EXTENSION_NOTIFICATIONS_JSON=
EXTENSION_TUTORIALS_JSON=
EXT_COMPAT_DECODER_V1=
# IDs Chrome não são segredos. Preserve apenas identidades ainda suportadas.
ZVM_EXTENSION_IDS=bdhnikgcdccjabkmbfcakgjkkgdlmgja,ckbffcbmanboelbihfkhiahgafnimcho,kchicphaoknflbgajcngndanjekhpdok,kchicphaoknflbgajcngndanjekhpdek
MAX_PHONES_GLOBAL=50
EXPIRY_WARN_HOURS=48

# Build Authority / Registry V2
ZVM_BUILD_ENFORCE=false
ZVM_BUILD_REGISTRY_V2_EXTRA_JSON=
ZVM_LEGACY_V3_ALLOW=false
ZVM_DEV_BUILD_ALLOW=false
ZVM_DEV_COHOST_ALLOW=true
ZVM_DEV_BUILD_KEY_HASHES=
ZVM_DEV_BUILD_DEVICE_HASHES=
ZVM_OFFICIAL_BUILDS=
ZVM_DENIED_BUILDS=

# Signed DEV authority — segredos/chaves privadas nunca vão ao Git
ZVM_DEV_SIGNED_BUILDS_ALLOW=false
ZVM_DEV_EXTENSION_ID=
ZVM_DEV_SIGNING_KEY_ID=
ZVM_DEV_SIGNING_PRIVATE_KEY_B64=
ZVM_DEV_SIGNING_PUBLIC_KEY_B64=
ZVM_DEV_BUILD_AGENT_TOKEN_SHA256=
ZVM_DEV_BUILD_MAX_AGE_DAYS=7
ZVM_DEV_SESSION_TTL_HOURS=12
ZVM_DEV_LICENSE_KEY_HASHES=

# Meta / WhatsApp Business Platform — backend preservado; UI cliente dormente/oculta até validação end-to-end
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_TOKEN_ENCRYPTION_KEY=
META_WEBHOOK_VERIFY_TOKEN=
# Em 2026-10-06, a Graph API pública já está na v26.0. O fallback v23.0 abaixo
# permanece INTENCIONALMENTE congelado porque Meta está dormente/oculta na ZVM;
# só promover a versão após revalidação end-to-end do Embedded Signup/webhooks.
META_GRAPH_VERSION=v23.0
META_AUTO_REGISTER_PHONE=1
META_WEBHOOK_RETENTION_DAYS=30

# Logs / proxy
TRUST_PROXY_HEADERS=1
LOG_RETENTION_DAYS=90
LOG_MAX=500

# Ajustes avançados — deixe padrão salvo necessidade operacional medida
CAKTO_SIGNATURE_TOLERANCE_SECONDS=300
CAKTO_WORKER_POLL_MS=5000
CAKTO_WORKER_LEASE_MS=120000
CAKTO_WORKER_MAX_ATTEMPTS=8
CAKTO_WORKER_BATCH=10
CAKTO_EVENT_RETENTION_DAYS=30
CAKTO_DEAD_LETTER_RETENTION_DAYS=90
CAKTO_QUEUE_MAX_ACTIVE=5000
CAKTO_MAIL_MAX_ATTEMPTS=8
CAKTO_MAIL_BATCH=10
CAKTO_MAIL_RETENTION_DAYS=30
CAKTO_MAIL_DEAD_LETTER_RETENTION_DAYS=90
WORKER_LOCK_RETENTION_HOURS=24
COMMERCIAL_LOCK_LEASE_MS=120000
COMMERCIAL_LOCK_WAIT_MS=5000
COMMERCIAL_LOCK_HEARTBEAT_MS=40000
COMMERCIAL_TX_CLAIM_LEASE_MS=120000
COMMERCIAL_TX_CLAIM_WAIT_MS=5000
COMMERCIAL_TX_CLAIM_RETENTION_DAYS=400
ZVM_LEGACY_SHIELD_CHECK_TTL_MS=300000
ZVM_LEGACY_SHIELD_KEY_TTL_MS=3600000
ZVM_LEGACY_SHIELD_MAX_ENTRIES=2048

# LOCAL ONLY
# O launcher define estas variáveis externamente e prevalece sobre zvm.env:
# ZVM_LOCAL_SAFE_MODE=1
# RENDER=false
# NODE_ENV=development
# BASE_URL=http://localhost:3000
# PORT=3000
# TRUST_PROXY_HEADERS=0
