*.db
*.dump
*.sql
*.secret
*.secrets
RELEASE_SHA256SUMS.txt

# Exclude non-runtime sources. Runtime code is copied explicitly in Dockerfile.
release
release-assets
audits
docs
test
tests
tools
*.md
