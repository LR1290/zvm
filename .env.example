# ZVM / Render — template sanitizado
# Não copie segredos antigos. Preencha com valores novos no painel Environment do Render.

NODE_ENV=production
PORT=3000
BASE_URL=https://zvm.onrender.com

# Núcleo administrativo / criptografia
ADMIN_USER=
ADMIN_PASS=
APP_SECRET=
TOTP_SECRET=
ANALYTICS_PASS=
ANALYTICS_TOTP_SECRET=
# Recomendado em produção: chave dedicada de 32 bytes (base64/hex aceito pelo runtime).
# A variável PREVIOUS só é usada durante rotação controlada.
PORTAL_TOTP_ENCRYPTION_KEY=
PORTAL_TOTP_ENCRYPTION_KEY_PREVIOUS=
PORTAL_TOTP_MIGRATE_LEGACY=0

# Banco
MONGODB_URI=
MONGODB_DB=zapvoice

# E-mail
RESEND_API_KEY=
EMAIL_FROM=ZVM <noreply@SEU_DOMINIO>
EMAIL_REPLY_TO=suporte@SEU_DOMINIO

# Comercial / webhooks
CAKTO_WEBHOOK_SECRET=
# Segredo dedicado recomendado para recuperação/outbox Cakto. Se vazio, o runtime
# usa APP_SECRET como fallback; PREVIOUS é apenas para rotação controlada.
CAKTO_RECOVERY_SECRET=
CAKTO_RECOVERY_SECRET_PREVIOUS=
WEBHOOK_URL=

# Cakto — IDs oficiais, quando disponíveis
CAKTO_SOLO_OFFER_ID=
CAKTO_SOLO_PRODUCT_ID=
CAKTO_PADRAO_OFFER_ID=
CAKTO_PADRAO_PRODUCT_ID=
CAKTO_PRO_OFFER_ID=
CAKTO_PRO_PRODUCT_ID=
CAKTO_EMPRESARIAL_OFFER_ID=
CAKTO_EMPRESARIAL_PRODUCT_ID=

# Extensão ZVM
# ZVM_EXTENSION_IDS aceita IDs Chrome separados por vírgula. Inclua somente
# extensões que você controla. ATENÇÃO: uma allowlist não vazia filtra clientes
# V1/V2 mesmo com ZVM_BUILD_ENFORCE=false e, no runtime R32 com Build Authority
# ativo, esta variável é obrigatória em produção. Preserve TODOS os IDs oficiais
# que ainda precisam coexistir; não substitua a lista por apenas DEV ou BETA.
# Inventário operacional confirmado em 2026-09-17:
#   BETA............. bdhnikgcdccjabkmbfcakgjkkgdlmgja
#   DEV.............. ckbffcbmanboelbihfkhiahgafnimcho
#   LEGADO ATUAL..... kchicphaoknflbgajcngndanjekhpdok
#   LEGADO ANTERIOR.. kchicphaoknflbgajcngndanjekhpdek
# Os IDs não são segredos. Revise esta lista sempre que uma nova identidade de
# extensão for criada, revogada ou aposentada. Ver DEPLOYMENT_CONFIGURATION.md.
EXTENSION_URL=
EXTENSION_VERSION=
EXTENSION_CHANGELOG=
ZVM_EXTENSION_IDS=bdhnikgcdccjabkmbfcakgjkkgdlmgja,ckbffcbmanboelbihfkhiahgafnimcho,kchicphaoknflbgajcngndanjekhpdok,kchicphaoknflbgajcngndanjekhpdek
MAX_PHONES_GLOBAL=50
EXPIRY_WARN_HOURS=48

# Meta / WhatsApp Business Platform — variáveis reservadas para a etapa Meta.
# A build de recuperação canônica 2026-09-02 não reconstitui esse subsistema
# automaticamente a partir de fragmentos históricos.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_TOKEN_ENCRYPTION_KEY=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
META_AUTO_REGISTER_PHONE=1
META_WEBHOOK_RETENTION_DAYS=30

# Infraestrutura / manutenção
# 1 somente atrás de proxy confiável (Render). No Render, RENDER=true também
# habilita a leitura dos headers de proxy.
TRUST_PROXY_HEADERS=1
LOG_RETENTION_DAYS=90
LOG_MAX=500

# REMOVIDO: MOD_USER, MOD_PASS, MOD_TOTP, MOD2_*, MOD3_*, MOD4_*, MOD5_*, MOD6_*
# O servidor solo não lê mais nenhuma variável de moderador.

# Build Authority / integridade de builds
# zvm-official-builds.json = Registry V1 legado (inclui o rollback V731/0.8.526).
# V738/0.8.533 usa somente dois perfis: DEV legível (channel=dev/profile=dev) e
# BETA release-grade (channel=beta/profile=release). Não existe artefato PRODUCTION V738.
# A BETA é a candidata de RELEASE e será promovida/renomeada após qualificação na CWS.
# DEV e BETA V738 estão registradas no Registry V2 com seus IDs exatos. DEV co-hospedada
# no mesmo servidor de produção exige ZVM_DEV_COHOST_ALLOW=true; o bypass antigo de
# staging continua separado e permanece desativado em produção. V737/V736/V735 e V733/0.8.528
# permanecem conhecidos para transição/rollback; V734/0.8.529 permanece revogada.
# Mantenha enforcement global desligado durante o rollout de compatibilidade até os gates
# CWS/GitHub/Render/smoke estarem concluídos e a allowlist global estiver inventariada.
ZVM_RUNTIME_ENV=production
ZVM_BUILD_REGISTRY_V2_EXTRA_JSON=
ZVM_LEGACY_V3_ALLOW=true
ZVM_BUILD_ENFORCE=false
ZVM_DEV_BUILD_ALLOW=false
ZVM_DEV_COHOST_ALLOW=true
ZVM_DEV_BUILD_KEY_HASHES=
ZVM_DEV_BUILD_DEVICE_HASHES=
# Overrides/revogação emergencial opcionais (JSON/formatos aceitos pelo runtime).
ZVM_OFFICIAL_BUILDS=
ZVM_DENIED_BUILDS=
# ZVM_EXTENSION_IDS já é declarado na seção Extensão ZVM acima.

# Signed DEV build authority (production cohost)
# One-time setup. Keep private key and raw Build Agent token out of source control.
ZVM_DEV_SIGNED_BUILDS_ALLOW=false
ZVM_DEV_EXTENSION_ID=
ZVM_DEV_SIGNING_KEY_ID=
ZVM_DEV_SIGNING_PRIVATE_KEY_B64=
ZVM_DEV_SIGNING_PUBLIC_KEY_B64=
ZVM_DEV_BUILD_AGENT_TOKEN_SHA256=
ZVM_DEV_BUILD_MAX_AGE_DAYS=7
ZVM_DEV_SESSION_TTL_HOURS=12
# Optional SHA-256 allowlist for normal ZVM keys with DEV access; keyRecord.devAccess=true also grants access.
ZVM_DEV_LICENSE_KEY_HASHES=
